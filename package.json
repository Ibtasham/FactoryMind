{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && tsx scripts/static-check.ts",
    "readme:update": "tsx scripts/update-readme.ts",
    "test:unit": "tsx --test src/engine/engines.test.ts src/engine/factorySim.test.ts src/store/store.test.ts",
    "test:math": "tsx --test src/engine/mathValidation.test.ts src/engine/desEngine.test.ts",
    "test:des": "tsx --test src/engine/desEngine.test.ts",
    "test:scenario": "tsx --test src/engine/scenarioStudio.test.ts",
    "test:twin": "tsx --test src/engine/digitalTwin.test.ts",
    "test:assistant": "tsx --test src/engine/decisionAssistant.test.ts",
    "test:integration": "tsx --test src/engine/integration.test.ts",
    "test": "tsx --test src/engine/engines.test.ts src/engine/factorySim.test.ts src/engine/mathValidation.test.ts src/engine/desEngine.test.ts src/engine/scenarioStudio.test.ts src/engine/digitalTwin.test.ts src/engine/decisionAssistant.test.ts src/engine/uxHelpers.test.ts src/engine/integration.test.ts src/engine/auditFixes.test.ts src/engine/functionalVerification.test.ts src/engine/researchBenchmark.test.ts src/store/store.test.ts server.test.ts",
    "verify": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "express": "^5.3.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
